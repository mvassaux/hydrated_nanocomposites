#-------------------------------------------------------------------------------
# Write Out
#-------------------------------------------------------------------------------

shell mkdir Output
shell cd Output

write_data              data.polymer nocoeff
write_coeff             polymer.coeff

group2ndx               groups_index.ndx subset_graphene subset_CH3 subset_NH2
