variable dir equal 5
include displace.mod
print "${C15},${C25},${C35},${C45},${C55},${C65}" append EConstant.txt

# uxy Perturbation

variable dir equal 6
include displace.mod
print "${C16},${C26},${C36},${C46},${C56},${C66}" append EConstant.txt
